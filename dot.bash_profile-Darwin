# macOS-specific interactive settings. Homebrew is optional.
decho "$HOME/.bash_profile-Darwin"

# Homebrew's opt links work on Intel and Apple Silicon without pinned cellar versions.
if command -v brew >/dev/null 2>&1; then
    brew_prefix=$(brew --prefix)
    for formula in llvm gpg ruby make util-linux mysql-client openssl perl; do
        path-prepend "$brew_prefix/opt/$formula/bin"
    done
    if [ -x "$brew_prefix/opt/perl/bin/perl" ]; then
        # @var PERL
        # @help Perl do Homebrew quando instalado.
        export PERL="$brew_prefix/opt/perl/bin/perl"
        # @var CPAN
        # @help CPAN associado ao Perl do Homebrew.
        export CPAN="$brew_prefix/opt/perl/bin/cpan"
    fi
    unset formula brew_prefix
fi

path-prepend "$HOME/.gem/bin" \
    '/Applications/Sublime Text.app/Contents/SharedSupport/bin' \
    '/Applications/Sublime Merge.app/Contents/SharedSupport/bin' \
    '/Applications/Couchbase Server.app/Contents/Resources/couchbase-core/bin' \
    /Library/TeX/texbin

if [ -x /usr/libexec/java_home ]; then
    # @var JAVA_HOME
    # @help JDK encontrado por java_home no macOS.
    java_home=$(/usr/libexec/java_home 2>/dev/null) && export JAVA_HOME="$java_home"
    unset java_home
fi

# @var LSCOLORS
# @help Cores de ls no macOS.

# @var CLICOLOR
# @help Habilita cores de ls no macOS.
export LSCOLORS='ExGxBxDxCxEgEdxbxgxcxd' CLICOLOR=1
# @var _LS
# @help Comando ls disponível; gls quando instalado no macOS.
export _DD=dd _LS=ls
command -v gdd >/dev/null 2>&1 && export _DD=gdd
command -v gls >/dev/null 2>&1 && export _LS=gls

alias show-cpu-info='sysctl -n machdep.cpu.brand_string'
alias ldd='otool -L'
alias ls='ls -G'

# @help ps sem argumentos usa procs (se instalado); com argumentos, ps nativo (grc se houver).
# procps é só Linux (precisa de /proc), então no macOS o equivalente é o procs.
_PS_WRAPPED=1
ps() {
    if [ -t 1 ] && [ $# -eq 0 ] && command -v procs >/dev/null 2>&1; then
        procs
    elif [ -t 1 ] && command -v grc >/dev/null 2>&1; then
        grc -es ps "$@"
    else
        command ps "$@"
    fi
}

# @var ANDROID_AVD_HOME
# @help Diretório dos dispositivos virtuais Android.
export ANDROID_AVD_HOME="$HOME/.android/avd"
# @var ANDROID_HOME
# @help Diretório do SDK Android no macOS.
export ANDROID_HOME="$HOME/Library/Android/sdk"
# @var ANDROID_SDK_ROOT
# @help Raiz do SDK Android.
export ANDROID_SDK_ROOT="$ANDROID_HOME"
# O SDK do Android não fica mais no PATH (inclusive entradas herdadas do shell pai).
path-remove "$ANDROID_SDK_ROOT/*"

# @help Remove caches e versões antigas do Homebrew (macOS).
# @syntax brew-cleanup
brew-cleanup() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    _dotfiles-require "${FUNCNAME[0]}" brew || return
    brew cleanup --prune=all
}

# @help Seleciona uma versão local e inicializa pyenv.
# @syntax pyenv-hack-init <versão>
pyenv-hack-init() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    [ "$#" -eq 1 ] || {
        dotfiles-help --exact "${FUNCNAME[0]}" >&2
        return 2
    }
    _dotfiles-require "${FUNCNAME[0]}" pyenv || return
    pyenv local "$1" || return
    eval "$(pyenv init -)"
}

# @help Instala versões Python com bibliotecas Homebrew (macOS).
# @syntax pyenv-hack-install <versão> [...]
pyenv-hack-install() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    _dotfiles-require "${FUNCNAME[0]}" pyenv brew xcrun || return
    local version readline openssl sdk
    readline=$(brew --prefix readline) || return
    openssl=$(brew --prefix openssl) || return
    sdk=$(xcrun --show-sdk-path) || return
    for version in "$@"; do
        CFLAGS="-I$readline/include -I$openssl/include -I$sdk/usr/include" \
            LDFLAGS="-L$readline/lib -L$openssl/lib" pyenv install -v "$version" || return
    done
}

# @help Lista versões Python conhecidas pelo pyenv.
# @syntax pyenv-hack-list
pyenv-hack-list() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    _dotfiles-require "${FUNCNAME[0]}" pyenv || return
    pyenv versions
}

# @help Remove ACLs e atributos estendidos recursivamente (macOS).
# @syntax reset-osx-acls <caminho> [...]
reset-osx-acls() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    [ "$#" -gt 0 ] || {
        dotfiles-help --exact "${FUNCNAME[0]}" >&2
        return 2
    }
    _dotfiles-require "${FUNCNAME[0]}" sudo chmod xattr || return
    sudo chmod -R -N "$@" && sudo xattr -rc "$@"
}

# @help Seleciona clang do Homebrew; aceita sufixo de versão.
# @syntax set-cc-brew-llvm [versão]
set-cc-brew-llvm() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    _dotfiles-require "${FUNCNAME[0]}" brew || return
    local prefix compiler
    prefix=$(brew --prefix llvm) || return
    compiler="$prefix/bin/clang${1:+-$1}"
    [ -x "$compiler" ] || { echo "Compiler not found: $compiler" >&2; return 1; }
    export CC="$compiler"
    printf 'CC="%s"\n' "$CC"
}

# @help Seleciona clang encontrado por xcrun (macOS).
# @syntax set-cc-xcode-clang
set-cc-xcode-clang() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    _dotfiles-require "${FUNCNAME[0]}" xcrun || return
    local compiler
    compiler=$(xcrun --find clang) || return
    export CC="$compiler"
    printf 'CC="%s"\n' "$CC"
}

alias cleanup-brew='brew-cleanup'

# @help Controla o XQuartz; desativar impede a inicialização automática na conta.
# @syntax xquartz <ativar|desativar|status>
xquartz() {
    case "${1:-}" in -h|--help) dotfiles-help --exact "${FUNCNAME[0]}"; return;; esac
    local dominio="gui/$(id -u)" servico=org.xquartz.startx
    local agente=/Library/LaunchAgents/org.xquartz.startx.plist
    case "${1:-}" in
        ativar)
            [ -f "$agente" ] || { echo 'XQuartz não está instalado.' >&2; return 1; }
            launchctl enable "$dominio/$servico" || return
            if ! launchctl print "$dominio/$servico" >/dev/null 2>&1; then
                launchctl bootstrap "$dominio" "$agente" || return
            fi
            open -a /Applications/Utilities/XQuartz.app
            ;;
        desativar)
            launchctl disable "$dominio/$servico" || return
            if launchctl print "$dominio/$servico" >/dev/null 2>&1; then
                launchctl bootout "$dominio/$servico" || return
            fi
            # O aplicativo pode sobreviver ao encerramento do agente.
            if pgrep -u "$(id -u)" -x X11.bin >/dev/null; then
                pkill -TERM -u "$(id -u)" -x X11.bin || {
                    ! pgrep -u "$(id -u)" -x X11.bin >/dev/null || return 1
                }
            fi
            ;;
        status)
            launchctl print-disabled "$dominio" || return
            pgrep -u "$(id -u)" -lf 'X11.bin|/opt/X11/bin/Xquartz' || true
            ;;
        *)
            printf 'Uso: xquartz <ativar|desativar|status>\n' >&2
            return 2
            ;;
    esac
}
true
